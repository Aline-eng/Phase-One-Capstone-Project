<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.igirepay.lab3_mini_capstone.controller.DashboardController"
           prefWidth="1000" prefHeight="660"
           style="-fx-background-color: #0D0D1A;">

    <!-- Phone frame -->
    <VBox alignment="CENTER" maxWidth="380" maxHeight="640"
          style="-fx-background-color: #1A1A1A;
                 -fx-background-radius: 40;
                 -fx-padding: 12;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.8), 40, 0, 0, 10);">

        <VBox style="-fx-background-color: #F0F2F5; -fx-background-radius: 32;"
              prefWidth="356" prefHeight="600">

            <!-- TOP NAVBAR -->
            <HBox style="-fx-background-color: #FFCC00; -fx-background-radius: 32 32 0 0;
                         -fx-padding: 14 20 14 20;"
                  alignment="CENTER">
                <!-- Profile button left -->
                <Button text="👤" onAction="#showProfile"
                        style="-fx-background-color: rgba(0,0,0,0.15); -fx-background-radius: 20;
                               -fx-padding: 6 10 6 10; -fx-cursor: hand; -fx-font-size: 14px;"/>
                <!-- Logo center -->
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="IgirePay" style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #1A1A2E;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <!-- Logout right -->
                <Button text="🔒 Logout" onAction="#handleLogout"
                        style="-fx-background-color: rgba(0,0,0,0.15); -fx-background-radius: 20;
                               -fx-padding: 6 10 6 10; -fx-cursor: hand; -fx-font-size: 11px;
                               -fx-text-fill: #1A1A2E; -fx-font-weight: bold;"/>
            </HBox>

            <!-- Scrollable content -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent;
                               -fx-border-color: transparent;">
                <VBox spacing="16" style="-fx-padding: 16 16 8 16;">

                    <!-- BALANCE CARD -->
                    <VBox style="-fx-background-color: #1A1A2E; -fx-background-radius: 20;
                                 -fx-padding: 20;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 12, 0, 0, 4);">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="📱" style="-fx-font-size: 14px;"/>
                            <Label fx:id="phoneLabel" text="0780 000 000"
                                   style="-fx-text-fill: #AAAAAA; -fx-font-size: 13px;"/>
                        </HBox>
                        <Label text="Available Balance"
                               style="-fx-text-fill: #888888; -fx-font-size: 12px; -fx-padding: 8 0 4 0;"/>
                        <Label fx:id="balanceLabel" text="0 RWF"
                               style="-fx-text-fill: #FFCC00; -fx-font-size: 30px; -fx-font-weight: bold;"/>
                        <Label fx:id="accountTypeLabel" text="Wallet Account"
                               style="-fx-text-fill: #666666; -fx-font-size: 11px; -fx-padding: 4 0 0 0;"/>

                        <!-- Statements and Cash Out buttons -->
                        <HBox spacing="12" style="-fx-padding: 16 0 0 0;">
                            <Button text="📋 STATEMENTS" onAction="#showHistory"
                                    style="-fx-background-color: rgba(255,204,0,0.15);
                                           -fx-text-fill: #FFCC00; -fx-font-size: 11px;
                                           -fx-font-weight: bold; -fx-background-radius: 8;
                                           -fx-padding: 8 12 8 12; -fx-cursor: hand;"
                                    HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button text="💵 CASH OUT" onAction="#showWithdraw"
                                    style="-fx-background-color: #FFCC00; -fx-text-fill: #1A1A2E;
                                           -fx-font-size: 11px; -fx-font-weight: bold;
                                           -fx-background-radius: 8; -fx-padding: 8 12 8 12;
                                           -fx-cursor: hand;"
                                    HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        </HBox>
                    </VBox>

                    <!-- PAY & BUY SECTION -->
                    <VBox style="-fx-background-color: #FFFFFF; -fx-background-radius: 16;
                                 -fx-padding: 16;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);"
                          spacing="12">
                        <Label text="Pay &amp; Buy"
                               style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1A1A2E;"/>
                        <GridPane hgap="12" vgap="12">
                            <!-- Row 1 -->
                            <VBox GridPane.columnIndex="0" GridPane.rowIndex="0"
                                  styleClass="action-tile" onMouseClicked="#showSendMoney"
                                  style="-fx-background-color: #FFF8E1; -fx-background-radius: 12;
                                         -fx-padding: 14; -fx-alignment: CENTER; -fx-cursor: hand;
                                         -fx-pref-width: 90; -fx-pref-height: 80;" spacing="6">
                                <Label text="💸" style="-fx-font-size: 22px;"/>
                                <Label text="Send Money" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #333333;" wrapText="true" alignment="CENTER"/>
                            </VBox>
                            <VBox GridPane.columnIndex="1" GridPane.rowIndex="0"
                                  onMouseClicked="#showDeposit"
                                  style="-fx-background-color: #E8F5E9; -fx-background-radius: 12;
                                         -fx-padding: 14; -fx-alignment: CENTER; -fx-cursor: hand;
                                         -fx-pref-width: 90; -fx-pref-height: 80;" spacing="6">
                                <Label text="⬇" style="-fx-font-size: 22px;"/>
                                <Label text="Deposit" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
                            </VBox>
                            <VBox GridPane.columnIndex="2" GridPane.rowIndex="0"
                                  onMouseClicked="#showWithdraw"
                                  style="-fx-background-color: #FFF3E0; -fx-background-radius: 12;
                                         -fx-padding: 14; -fx-alignment: CENTER; -fx-cursor: hand;
                                         -fx-pref-width: 90; -fx-pref-height: 80;" spacing="6">
                                <Label text="⬆" style="-fx-font-size: 22px;"/>
                                <Label text="Withdraw" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
                            </VBox>
                            <!-- Row 2 -->
                            <VBox GridPane.columnIndex="0" GridPane.rowIndex="1"
                                  onMouseClicked="#showAccounts"
                                  style="-fx-background-color: #E3F2FD; -fx-background-radius: 12;
                                         -fx-padding: 14; -fx-alignment: CENTER; -fx-cursor: hand;
                                         -fx-pref-width: 90; -fx-pref-height: 80;" spacing="6">
                                <Label text="💳" style="-fx-font-size: 22px;"/>
                                <Label text="Accounts" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
                            </VBox>
                            <VBox GridPane.columnIndex="1" GridPane.rowIndex="1"
                                  onMouseClicked="#showSavings"
                                  style="-fx-background-color: #F3E5F5; -fx-background-radius: 12;
                                         -fx-padding: 14; -fx-alignment: CENTER; -fx-cursor: hand;
                                         -fx-pref-width: 90; -fx-pref-height: 80;" spacing="6">
                                <Label text="🏦" style="-fx-font-size: 22px;"/>
                                <Label text="Savings" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
                            </VBox>
                            <VBox GridPane.columnIndex="2" GridPane.rowIndex="1"
                                  onMouseClicked="#showBuy"
                                  style="-fx-background-color: #FCE4EC; -fx-background-radius: 12;
                                         -fx-padding: 14; -fx-alignment: CENTER; -fx-cursor: hand;
                                         -fx-pref-width: 90; -fx-pref-height: 80;" spacing="6">
                                <Label text="🛒" style="-fx-font-size: 22px;"/>
                                <Label text="Buy" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
                            </VBox>
                        </GridPane>
                    </VBox>

                    <!-- RECENT TRANSACTIONS -->
                    <VBox style="-fx-background-color: #FFFFFF; -fx-background-radius: 16;
                                 -fx-padding: 16;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);"
                          spacing="10">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Recent Transactions"
                                   style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #1A1A2E;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Hyperlink text="See all" onAction="#showHistory"
                                       style="-fx-text-fill: #FFCC00; -fx-font-size: 12px;"/>
                        </HBox>
                        <VBox fx:id="recentTransactionsBox" spacing="8">
                            <Label text="No recent transactions"
                                   style="-fx-text-fill: #AAAAAA; -fx-font-size: 12px;"/>
                        </VBox>
                    </VBox>

                </VBox>
            </ScrollPane>

            <!-- BOTTOM NAVIGATION BAR -->
            <HBox style="-fx-background-color: #FFFFFF; -fx-background-radius: 0 0 32 32;
                         -fx-padding: 10 8 14 8;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, -2, 0);"
                  alignment="CENTER" spacing="0">

                <VBox alignment="CENTER" spacing="3" HBox.hgrow="ALWAYS" onMouseClicked="#showDashboard"
                      style="-fx-cursor: hand; -fx-padding: 4;">
                    <Label text="🏠" style="-fx-font-size: 18px;"/>
                    <Label text="Home" style="-fx-font-size: 9px; -fx-text-fill: #FFCC00; -fx-font-weight: bold;"/>
                </VBox>

                <VBox alignment="CENTER" spacing="3" HBox.hgrow="ALWAYS" onMouseClicked="#showSendMoney"
                      style="-fx-cursor: hand; -fx-padding: 4;">
                    <Label text="💸" style="-fx-font-size: 18px;"/>
                    <Label text="Send" style="-fx-font-size: 9px; -fx-text-fill: #888888;"/>
                </VBox>

                <!-- Center MomoPay button -->
                <VBox alignment="CENTER" spacing="3" HBox.hgrow="ALWAYS" onMouseClicked="#showTransactions"
                      style="-fx-cursor: hand; -fx-padding: 4;">
                    <StackPane>
                        <Circle radius="26"
                                style="-fx-fill: #FFCC00;
                                       -fx-effect: dropshadow(gaussian, rgba(255,204,0,0.5), 10, 0, 0, 2);"/>
                        <Label text="💳" style="-fx-font-size: 20px;"/>
                    </StackPane>
                    <Label text="MomoPay" style="-fx-font-size: 9px; -fx-text-fill: #888888;"/>
                </VBox>

                <VBox alignment="CENTER" spacing="3" HBox.hgrow="ALWAYS" onMouseClicked="#showBuy"
                      style="-fx-cursor: hand; -fx-padding: 4;">
                    <Label text="🛒" style="-fx-font-size: 18px;"/>
                    <Label text="Buy" style="-fx-font-size: 9px; -fx-text-fill: #888888;"/>
                </VBox>

                <VBox alignment="CENTER" spacing="3" HBox.hgrow="ALWAYS" onMouseClicked="#showMore"
                      style="-fx-cursor: hand; -fx-padding: 4;">
                    <Label text="⋯" style="-fx-font-size: 20px; -fx-text-fill: #888888;"/>
                    <Label text="More" style="-fx-font-size: 9px; -fx-text-fill: #888888;"/>
                </VBox>

            </HBox>

        </VBox>
    </VBox>
</StackPane>
