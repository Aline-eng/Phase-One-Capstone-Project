<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.igirepay.lab3_mini_capstone.controller.CustomerController"
           prefWidth="1000" prefHeight="660"
           style="-fx-background-color: #0D0D1A;">

    <VBox alignment="CENTER" maxWidth="380" maxHeight="640"
          style="-fx-background-color: #1A1A1A; -fx-background-radius: 40;
                 -fx-padding: 12;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.8), 40, 0, 0, 10);">

        <VBox style="-fx-background-color: #F0F2F5; -fx-background-radius: 32;"
              prefWidth="356" prefHeight="600">

            <!-- TOP BAR -->
            <HBox style="-fx-background-color: #FFCC00; -fx-background-radius: 32 32 0 0;
                         -fx-padding: 14 20 14 20;"
                  alignment="CENTER_LEFT" spacing="12">
                <Button text="←" onAction="#goBack"
                        style="-fx-background-color: rgba(0,0,0,0.15); -fx-background-radius: 16;
                               -fx-padding: 5 10 5 10; -fx-cursor: hand; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Customers"
                       style="-fx-font-weight: bold; -fx-font-size: 17px; -fx-text-fill: #1A1A2E;"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent;
                               -fx-border-color: transparent;">
                <VBox spacing="14" style="-fx-padding: 16 16 16 16;">

                    <!-- MY PROFILE CARD - shows logged-in customer -->
                    <VBox style="-fx-background-color: #1A1A2E; -fx-background-radius: 16;
                                 -fx-padding: 16;" spacing="8">
                        <Label text="My Profile"
                               style="-fx-text-fill: #AAAAAA; -fx-font-size: 12px;"/>
                        <Label fx:id="profileNameLabel" text="—"
                               style="-fx-text-fill: #FFFFFF; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                        <Label fx:id="profileEmailLabel" text="—"
                               style="-fx-text-fill: #888888; -fx-font-size: 12px;"/>
                        <Label fx:id="profilePhoneLabel" text="—"
                               style="-fx-text-fill: #FFCC00; -fx-font-size: 13px;"/>
                        <Label fx:id="profileIdLabel" text="—"
                               style="-fx-text-fill: #666666; -fx-font-size: 11px;"/>
                    </VBox>

                    <!-- FIND CUSTOMER CARD -->
                    <VBox style="-fx-background-color: #FFFFFF; -fx-background-radius: 16;
                                 -fx-padding: 16;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);"
                          spacing="12">
                        <Label text="Find Customer"
                               style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1A1A2E;"/>
                        <HBox spacing="10">
                            <TextField fx:id="searchIdField" promptText="Customer ID"
                                       HBox.hgrow="ALWAYS"
                                       style="-fx-background-radius: 8; -fx-border-radius: 8;
                                              -fx-border-color: #E0E0E0; -fx-padding: 8 12 8 12;"/>
                            <Button text="Find" onAction="#handleFind"
                                    style="-fx-background-color: #1A1A2E; -fx-text-fill: #FFFFFF;
                                           -fx-font-weight: bold; -fx-background-radius: 8;
                                           -fx-padding: 9 16 9 16; -fx-cursor: hand;"/>
                        </HBox>
                        <VBox fx:id="foundCustomerBox" spacing="4" managed="false" visible="false"
                              style="-fx-background-color: #F8F9FA; -fx-background-radius: 8; -fx-padding: 10;">
                            <Label fx:id="foundNameLabel"  text="" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                            <Label fx:id="foundEmailLabel" text="" style="-fx-font-size: 12px; -fx-text-fill: #555555;"/>
                            <Label fx:id="foundPhoneLabel" text="" style="-fx-font-size: 12px; -fx-text-fill: #555555;"/>
                        </VBox>
                        <Label fx:id="findMessageLabel" text="" style="-fx-font-size: 12px;"/>
                    </VBox>

                    <!-- UPDATE CUSTOMER CARD -->
                    <VBox style="-fx-background-color: #FFFFFF; -fx-background-radius: 16;
                                 -fx-padding: 16;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);"
                          spacing="12">
                        <Label text="Update Customer"
                               style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1A1A2E;"/>
                        <VBox spacing="8">
                            <TextField fx:id="updateIdField"    promptText="Customer ID"
                                       style="-fx-background-radius: 8; -fx-border-radius: 8;
                                              -fx-border-color: #E0E0E0; -fx-padding: 8 12 8 12;"/>
                            <TextField fx:id="updateNameField"  promptText="New full name"
                                       style="-fx-background-radius: 8; -fx-border-radius: 8;
                                              -fx-border-color: #E0E0E0; -fx-padding: 8 12 8 12;"/>
                            <TextField fx:id="updateEmailField" promptText="New email"
                                       style="-fx-background-radius: 8; -fx-border-radius: 8;
                                              -fx-border-color: #E0E0E0; -fx-padding: 8 12 8 12;"/>
                            <TextField fx:id="updatePhoneField" promptText="New phone number"
                                       style="-fx-background-radius: 8; -fx-border-radius: 8;
                                              -fx-border-color: #E0E0E0; -fx-padding: 8 12 8 12;"/>
                        </VBox>
                        <Label fx:id="updateMessageLabel" text="" wrapText="true"
                               style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <Button text="UPDATE" onAction="#handleUpdate" maxWidth="Infinity"
                                style="-fx-background-color: #1A1A2E; -fx-text-fill: #FFFFFF;
                                       -fx-font-weight: bold; -fx-background-radius: 8;
                                       -fx-padding: 10 0 10 0; -fx-cursor: hand;"/>
                    </VBox>

                    <!-- CHANGE PIN CARD -->
                    <VBox style="-fx-background-color: #FFFFFF; -fx-background-radius: 16;
                                 -fx-padding: 16;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);"
                          spacing="12">
                        <Label text="Change PIN"
                               style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1A1A2E;"/>
                        <PasswordField fx:id="currentPinField" promptText="Current PIN"
                                       style="-fx-background-radius: 8; -fx-border-radius: 8;
                                              -fx-border-color: #E0E0E0; -fx-padding: 8 12 8 12;"/>
                        <PasswordField fx:id="newPinField" promptText="New PIN (5 digits)"
                                       style="-fx-background-radius: 8; -fx-border-radius: 8;
                                              -fx-border-color: #E0E0E0; -fx-padding: 8 12 8 12;"/>
                        <PasswordField fx:id="confirmNewPinField" promptText="Confirm new PIN"
                                       style="-fx-background-radius: 8; -fx-border-radius: 8;
                                              -fx-border-color: #E0E0E0; -fx-padding: 8 12 8 12;"/>
                        <Label fx:id="pinMessageLabel" text="" wrapText="true"
                               style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <Button text="CHANGE PIN" onAction="#handleChangePin" maxWidth="Infinity"
                                style="-fx-background-color: #FFCC00; -fx-text-fill: #1A1A2E;
                                       -fx-font-weight: bold; -fx-background-radius: 8;
                                       -fx-padding: 10 0 10 0; -fx-cursor: hand;"/>
                    </VBox>

                </VBox>
            </ScrollPane>

            <!-- BOTTOM NAV -->
            <HBox style="-fx-background-color: #FFFFFF; -fx-background-radius: 0 0 32 32;
                         -fx-padding: 10 8 14 8;" alignment="CENTER" spacing="0">
                <VBox alignment="CENTER" spacing="3" HBox.hgrow="ALWAYS" onMouseClicked="#goHome"
                      style="-fx-cursor: hand; -fx-padding: 4;">
                    <Label text="🏠" style="-fx-font-size: 18px;"/>
                    <Label text="Home" style="-fx-font-size: 9px; -fx-text-fill: #888888;"/>
                </VBox>
                <VBox alignment="CENTER" spacing="3" HBox.hgrow="ALWAYS" onMouseClicked="#goTransactions"
                      style="-fx-cursor: hand; -fx-padding: 4;">
                    <Label text="💸" style="-fx-font-size: 18px;"/>
                    <Label text="Send" style="-fx-font-size: 9px; -fx-text-fill: #888888;"/>
                </VBox>
                <VBox alignment="CENTER" spacing="3" HBox.hgrow="ALWAYS" onMouseClicked="#goTransactions"
                      style="-fx-cursor: hand; -fx-padding: 4;">
                    <StackPane>
                        <Circle radius="26" style="-fx-fill: #FFCC00;"/>
                        <Label text="💳" style="-fx-font-size: 20px;"/>
                    </StackPane>
                    <Label text="MomoPay" style="-fx-font-size: 9px; -fx-text-fill: #888888;"/>
                </VBox>
                <VBox alignment="CENTER" spacing="3" HBox.hgrow="ALWAYS" onMouseClicked="#goAccounts"
                      style="-fx-cursor: hand; -fx-padding: 4;">
                    <Label text="🏦" style="-fx-font-size: 18px;"/>
                    <Label text="Buy" style="-fx-font-size: 9px; -fx-text-fill: #888888;"/>
                </VBox>
                <VBox alignment="CENTER" spacing="3" HBox.hgrow="ALWAYS"
                      style="-fx-cursor: hand; -fx-padding: 4;">
                    <Label text="⋯" style="-fx-font-size: 20px; -fx-text-fill: #FFCC00;"/>
                    <Label text="More" style="-fx-font-size: 9px; -fx-text-fill: #FFCC00; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

        </VBox>
    </VBox>
</StackPane>
