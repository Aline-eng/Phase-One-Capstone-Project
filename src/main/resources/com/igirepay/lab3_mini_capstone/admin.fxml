<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.igirepay.lab3_mini_capstone.controller.AdminController"
           prefWidth="1000" prefHeight="660"
           style="-fx-background-color: #0D0D1A;">

    <VBox alignment="CENTER" maxWidth="380" maxHeight="640"
          style="-fx-background-color: #1A1A1A; -fx-background-radius: 40;
                 -fx-padding: 12;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.8), 40, 0, 0, 10);">

        <VBox style="-fx-background-color: #F0F2F5; -fx-background-radius: 32;"
              prefWidth="356" prefHeight="600">

            <!-- TOP BAR - red to distinguish from user screens -->
            <HBox style="-fx-background-color: #E53935; -fx-background-radius: 32 32 0 0;
                         -fx-padding: 14 20 14 20;"
                  alignment="CENTER">
                <Label text="🛡 Admin Panel"
                       style="-fx-font-weight: bold; -fx-font-size: 17px; -fx-text-fill: #FFFFFF;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Logout" onAction="#handleLogout"
                        style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: #FFFFFF;
                               -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 8;
                               -fx-padding: 6 12 6 12; -fx-cursor: hand;"/>
            </HBox>

            <!-- Admin name -->
            <HBox style="-fx-background-color: #FFFFFF; -fx-padding: 10 16 10 16;" alignment="CENTER_LEFT">
                <Label fx:id="adminNameLabel" text="Welcome, Admin"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1A1A2E;"/>
            </HBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent;
                               -fx-border-color: transparent;">
                <VBox spacing="14" style="-fx-padding: 16 16 16 16;">

                    <!-- FIND AND MANAGE CUSTOMER -->
                    <VBox style="-fx-background-color: #FFFFFF; -fx-background-radius: 16;
                                 -fx-padding: 16;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);"
                          spacing="12">
                        <Label text="Find &amp; Manage Customer"
                               style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1A1A2E;"/>
                        <HBox spacing="10">
                            <TextField fx:id="searchIdField" promptText="Customer ID"
                                       HBox.hgrow="ALWAYS"
                                       style="-fx-background-radius: 8; -fx-border-radius: 8;
                                              -fx-border-color: #E0E0E0; -fx-padding: 8 12 8 12;"/>
                            <Button text="Find" onAction="#handleFind"
                                    style="-fx-background-color: #1A1A2E; -fx-text-fill: #FFFFFF;
                                           -fx-font-weight: bold; -fx-background-radius: 8;
                                           -fx-padding: 9 16 9 16; -fx-cursor: hand;"/>
                        </HBox>

                        <VBox fx:id="foundCustomerBox" spacing="8" managed="false" visible="false"
                              style="-fx-background-color: #F8F9FA; -fx-background-radius: 10; -fx-padding: 12;">
                            <Label fx:id="foundNameLabel" text=""
                                   style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                            <Label fx:id="foundEmailLabel" text=""
                                   style="-fx-font-size: 12px; -fx-text-fill: #555555;"/>
                            <Label fx:id="foundPhoneLabel" text=""
                                   style="-fx-font-size: 12px; -fx-text-fill: #555555;"/>
                            <Label fx:id="foundRoleLabel" text=""
                                   style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
                            <Label fx:id="foundAttemptsLabel" text=""
                                   style="-fx-font-size: 11px;"/>
                            <HBox spacing="8">
                                <Button text="🔓 Unlock" onAction="#handleUnlock"
                                        style="-fx-background-color: #43A047; -fx-text-fill: #FFFFFF;
                                               -fx-font-size: 11px; -fx-font-weight: bold;
                                               -fx-background-radius: 8; -fx-padding: 8 10 8 10; -fx-cursor: hand;"
                                        HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Button text="🔄 Reset Attempts" onAction="#handleResetAttempts"
                                        style="-fx-background-color: #FF9800; -fx-text-fill: #FFFFFF;
                                               -fx-font-size: 11px; -fx-font-weight: bold;
                                               -fx-background-radius: 8; -fx-padding: 8 10 8 10; -fx-cursor: hand;"
                                        HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            </HBox>
                        </VBox>
                        <Label fx:id="findMessageLabel" text="" wrapText="true"
                               style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                    </VBox>

                    <!-- VIEW ANY ACCOUNT TRANSACTIONS -->
                    <VBox style="-fx-background-color: #FFFFFF; -fx-background-radius: 16;
                                 -fx-padding: 16;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);"
                          spacing="12">
                        <Label text="View Account Transactions"
                               style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1A1A2E;"/>
                        <HBox spacing="10">
                            <TextField fx:id="txAccountIdField" promptText="Any account ID"
                                       HBox.hgrow="ALWAYS"
                                       style="-fx-background-radius: 8; -fx-border-radius: 8;
                                              -fx-border-color: #E0E0E0; -fx-padding: 8 12 8 12;"/>
                            <Button text="Load" onAction="#handleLoadTransactions"
                                    style="-fx-background-color: #E53935; -fx-text-fill: #FFFFFF;
                                           -fx-font-weight: bold; -fx-background-radius: 8;
                                           -fx-padding: 9 16 9 16; -fx-cursor: hand;"/>
                        </HBox>
                        <Label fx:id="txSummaryLabel" text=""
                               style="-fx-font-size: 11px; -fx-text-fill: #888888;"/>
                        <VBox fx:id="txListBox" spacing="6">
                            <Label text="Enter an account ID to view its transactions."
                                   style="-fx-text-fill: #AAAAAA; -fx-font-size: 12px;"/>
                        </VBox>
                    </VBox>

                    <!-- DAILY TRANSACTION SUMMARY -->
                    <VBox style="-fx-background-color: #FFFFFF; -fx-background-radius: 16;
                                 -fx-padding: 16;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);"
                          spacing="10">
                        <Label text="Daily Transaction Summary"
                               style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1A1A2E;"/>
                        <HBox spacing="10">
                            <TextField fx:id="summaryAccountIdField" promptText="Account ID"
                                       HBox.hgrow="ALWAYS"
                                       style="-fx-background-radius: 8; -fx-border-radius: 8;
                                              -fx-border-color: #E0E0E0; -fx-padding: 8 12 8 12;"/>
                            <Button text="Load" onAction="#handleLoadDailySummary"
                                    style="-fx-background-color: #1A1A2E; -fx-text-fill: #FFFFFF;
                                           -fx-font-weight: bold; -fx-background-radius: 8;
                                           -fx-padding: 9 16 9 16; -fx-cursor: hand;"/>
                        </HBox>
                        <VBox fx:id="dailySummaryListBox" spacing="4">
                            <Label text="Enter an account ID to view daily summaries."
                                   style="-fx-text-fill: #AAAAAA; -fx-font-size: 12px;"/>
                        </VBox>
                    </VBox>

                    <!-- LOAN MANAGEMENT -->
                    <VBox style="-fx-background-color: #FFFFFF; -fx-background-radius: 16;
                                 -fx-padding: 16;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);"
                          spacing="10">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Loan Requests"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1A1A2E;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Refresh" onAction="#loadAllLoans"
                                    style="-fx-background-color: #F0F2F5; -fx-text-fill: #555555;
                                           -fx-font-size: 11px; -fx-background-radius: 6;
                                           -fx-padding: 5 10 5 10; -fx-cursor: hand;"/>
                        </HBox>
                        <VBox fx:id="loansListBox" spacing="6">
                            <Label text="Press Refresh to load loan requests."
                                   style="-fx-text-fill: #AAAAAA; -fx-font-size: 12px;"/>
                        </VBox>
                    </VBox>

                    <!-- ALL CUSTOMERS LIST -->
                    <VBox style="-fx-background-color: #FFFFFF; -fx-background-radius: 16;
                                 -fx-padding: 16;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);"
                          spacing="10">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="All Customers"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1A1A2E;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Refresh" onAction="#loadAllCustomers"
                                    style="-fx-background-color: #F0F2F5; -fx-text-fill: #555555;
                                           -fx-font-size: 11px; -fx-background-radius: 6;
                                           -fx-padding: 5 10 5 10; -fx-cursor: hand;"/>
                        </HBox>
                        <VBox fx:id="customersListBox" spacing="6">
                            <Label text="Press Refresh to load all customers."
                                   style="-fx-text-fill: #AAAAAA; -fx-font-size: 12px;"/>
                        </VBox>
                    </VBox>

                </VBox>
            </ScrollPane>

            <!-- BOTTOM INDICATOR - no nav for admin, just a home indicator -->
            <HBox alignment="CENTER" style="-fx-background-color: #FFFFFF;
                                            -fx-background-radius: 0 0 32 32; -fx-padding: 12 0 14 0;">
                <Rectangle width="80" height="4" arcWidth="4" arcHeight="4"
                           style="-fx-fill: #CCCCCC;"/>
            </HBox>

        </VBox>
    </VBox>
</StackPane>
